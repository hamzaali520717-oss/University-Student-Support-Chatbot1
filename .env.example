DJANGO_SETTINGS_MODULE=config.settings.dev
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_TIME_ZONE=UTC

POSTGRES_DB=university_portal
POSTGRES_USER=university_portal
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgres://university_portal:change-me@db:5432/university_portal

JWT_ACCESS_TOKEN_MINUTES=15
JWT_REFRESH_TOKEN_DAYS=7

# Assistant app (RAG)
GEMINI_API_KEY=
ASK_THROTTLE_RATE=20/hour
# Leave unset unless you have a client/API tier verified to exclude prompts
# from model training - questions containing a student's own data fail
# closed (refuse to answer) rather than use the default client without it.
ASSISTANT_LLM_CLIENT_PRIVATE=
